{
  "name": "Egregious Industrialization",
  "version": "0.5.0",
  "release_type": "alpha",
  "description": "A mildly gregged Modern Industrialization modpack",
  "author": "fmbellomy",
  "overrides": [
    "config",
    "defaultconfigs",
    "kubejs",
    "modern_industrialization",
    "!kubejs/probe/**"
